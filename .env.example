# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://skillgap:skillgap@localhost:5432/skillgap"

# Word → PDF conversion (the gotenberg service in docker-compose.yml)
GOTENBERG_URL="http://localhost:3100"

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI providers — set any subset; every configured provider runs in parallel.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Or use your Claude subscription instead of ANTHROPIC_API_KEY (personal use only):
# install Claude Code, run `claude setup-token`, and paste the token here.
# Used only when ANTHROPIC_API_KEY is empty.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_MODEL=sonnet
# CLAUDE_CLI_PATH=/path/to/claude

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5.5
# GOOGLE_MODEL=gemini-pro-latest
