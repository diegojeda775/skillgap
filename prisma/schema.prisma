generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes  Resume[]
  analyses Analysis[]
  jobs     Job[]
}

/// One resume version, e.g. "Frontend" or "IT Support". `skills` is the editable
/// skills section; keywords from an analysis can be added to it.
model Resume {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fileName  String
  text      String   @db.Text
  skills    String[] @default([])
  /// The uploaded file. DOCX files are edited in place so their formatting is kept.
  file      Bytes?
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
  jobs     Job[]

  @@index([userId, createdAt])
}

enum AnalysisStatus {
  QUEUED
  EXTRACTING
  COMPARING
  COMPLETE
  FAILED
}

model Analysis {
  id          String         @id @default(cuid())
  userId      String
  resumeId    String
  jobId       String?
  jobUrl      String?
  jobText     String         @db.Text
  jobTitle    String?
  company     String?
  status      AnalysisStatus @default(QUEUED)
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  items  AnalysisItem[]
  runs   ProviderRun[]

  @@index([userId, createdAt])
  @@index([jobId])
}

enum ItemCategory {
  HARD_SKILL
  TOOL
  CERTIFICATION
  EDUCATION
  EXPERIENCE
  DOMAIN
  SOFT_SKILL
}

enum Importance {
  REQUIRED
  PREFERRED
}

enum MatchStatus {
  MATCHED
  PARTIAL
  MISSING
}

/// One deduplicated requirement from the job ad. The Keywords view shows all
/// items; the Gaps view shows PARTIAL and MISSING ones. `key` is the normalized
/// name, so the unique index guarantees no duplicates per analysis.
model AnalysisItem {
  id         String       @id @default(cuid())
  analysisId String
  key        String
  name       String
  aliases    String[]
  category   ItemCategory
  importance Importance
  detail     String?
  status     MatchStatus
  evidence   String?
  note       String?
  /// Providers that extracted this requirement from the job ad.
  foundBy    String[]
  /// Share of comparing providers whose verdict equals `status` (0–1).
  agreement  Float

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, key])
}

enum PipelineStep {
  EXTRACT
  COMPARE
}

/// One AI call, kept for debugging, cost tracking and provider quality comparison.
model ProviderRun {
  id           String       @id @default(cuid())
  analysisId   String
  provider     String
  model        String
  step         PipelineStep
  ok           Boolean
  latencyMs    Int
  inputTokens  Int?
  outputTokens Int?
  error        String?
  createdAt    DateTime     @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

// --- Job tracker ---

enum JobStage {
  SAVED
  OUTREACH
  APPLIED
  INTERVIEWING
  OFFER
  CLOSED
}

enum JobOutcome {
  ACCEPTED
  REJECTED
  WITHDREW
  NO_RESPONSE
}

model Job {
  id             String      @id @default(cuid())
  userId         String
  title          String
  company        String?
  location       String?
  salary         String?
  url            String?
  description    String      @db.Text
  notes          String      @default("") @db.Text
  stage          JobStage    @default(SAVED)
  /// Sort order within a board column; new positions are midpoints between neighbors.
  position       Float       @default(0)
  outcome        JobOutcome?
  /// The resume version used (or planned) for this application.
  resumeId       String?
  nextAction     String?
  nextActionAt   DateTime?
  appliedAt      DateTime?
  stageChangedAt DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume   Resume?    @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  analyses Analysis[]
  events   JobEvent[]

  @@index([userId, stage, position])
}

/// Stage history, used for the timeline and conversion stats.
model JobEvent {
  id        String    @id @default(cuid())
  jobId     String
  from      JobStage?
  to        JobStage
  createdAt DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
